{
  "name": "phage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:itch": "tsc && vite build --base ./ --outDir dist-itch && cd dist-itch && rm -f ../phage-itch.zip && zip -qr ../phage-itch.zip .",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260521.1",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "pixi.js": "^8.6.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
